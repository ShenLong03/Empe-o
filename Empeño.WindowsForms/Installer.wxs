<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalador de la VERSIÓN NUEVA (WebView2) generado con WiX.
  CONVIVE con la versión clásica ya instalada en los locales: usa un UpgradeCode,
  ProductName y carpeta de instalación DISTINTOS, así Windows lo trata como un
  producto independiente (entrada aparte en "Agregar o quitar programas",
  carpeta propia en Archivos de programa, y su propio acceso directo).
  Empaqueta todo bin\Debug (exe + DLLs + WebView2Loader + Dashboard\*.html + Comprobantes).
  Build:  wix build Installer.wxs -o "Empenos-Nueva-V2.4.5.msi"
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Empeños Nueva Versión"
           Manufacturer="Tico Manager"
           Version="2.4.5"
           UpgradeCode="99FC9FF4-D354-49BB-8E48-7A2440CC6507"
           Scope="perUser"
           Compressed="yes">

    <!-- Solo bloquea instalar SOBRE una versión MÁS NUEVA de sí mismo; NO toca la clásica (otro UpgradeCode). -->
    <MajorUpgrade DowngradeErrorMessage="Ya hay una versión más reciente de Empeños Nueva Versión instalada." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Ícono de la app (estrella dorada con la E de Empeños). Se usa para los accesos directos
         del Menú Inicio y del Escritorio y para el ícono del producto en "Agregar o quitar programas". -->
    <Icon Id="AppIcon" SourceFile="Estrella.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Instalación POR USUARIO (LocalAppData) → NO requiere administrador; el doble-clic funciona sin UAC. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="MFGDIR" Name="Tico Manager">
          <Directory Id="INSTALLFOLDER" Name="Empeños Nueva Versión" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SHORTCUTDIR" Name="Empeños Nueva Versión" />
    </StandardDirectory>
    <!-- Directorio del ESCRITORIO del usuario (per-user, no requiere admin). -->
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Empeños Nueva Versión" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Cosecha TODO bin\Debug (recursivo), recreando subcarpetas (Dashboard, runtimes, Comprobantes, idiomas). -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="bin\Debug\**" />
    </ComponentGroup>

    <!-- Acceso directo en el menú Inicio (no toca el de la versión clásica). -->
    <Component Id="Shortcuts" Directory="SHORTCUTDIR" Guid="67A1AFD9-0872-4998-AD88-C901B61522D8">
      <Shortcut Id="StartShortcut"
                Name="Empeños"
                Description="Sistema de Empeños — versión nueva (WebView2)"
                Target="[INSTALLFOLDER]Empeño.WindowsForms.Nueva.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon"
                IconIndex="0" />
      <RemoveFolder Id="RemoveShortcutDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\TicoManager\EmpenosNuevaVersion" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Acceso directo en el ESCRITORIO del usuario, con la estrella dorada de la marca.
         Se crea automáticamente al instalar y se elimina al desinstalar. -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="A2F4B891-6C3E-4D57-8B29-1E9F5A8D2C63">
      <Shortcut Id="AppDesktopShortcut"
                Name="Empeños"
                Description="Sistema de Empeños — versión nueva (WebView2)"
                Target="[INSTALLFOLDER]Empeño.WindowsForms.Nueva.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon"
                IconIndex="0" />
      <RegistryValue Root="HKCU" Key="Software\TicoManager\EmpenosNuevaVersion" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

  </Package>
</Wix>
